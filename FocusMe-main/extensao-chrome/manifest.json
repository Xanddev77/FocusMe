{
  "manifest_version": 3,
  "name": "FocusMe — Bloqueio de Distrações",
  "short_name": "FocusMe",
  "version": "1.0.0",
  "description": "Bloqueia redes sociais enquanto o Pomodoro do FocusMe está em foco e libera nas pausas.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FocusMe",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs", "webNavigation", "alarms", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://localhost/*",
        "file:///*",
        "https://*.github.io/*",
        "https://*.netlify.app/*",
        "https://*.vercel.app/*",
        "https://*.web.app/*",
        "https://*.firebaseapp.com/*",
        "https://*.pages.dev/*",
        "https://*.onrender.com/*",
        "https://*.surge.sh/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
